{
  "expo": {
    "name": "Sunlight Grace Church",
    "slug": "grace-church",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "bundleIdentifier": "com.graceorlandochurch.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["en", "ko", "es"],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "locales": {
      "en": "./locales/en.json",
      "ko": "./locales/ko.json",
      "es": "./locales/es.json"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.graceorlandochurch.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photo library to share photos of community gatherings."
        }
      ]
    ],
    "owner": "sundayproject",
    "extra": {
      "eas": {
        "projectId": "6ba2320d-f618-45bd-859f-afd5c6c7b8cc"
      }
    }
  }
}
